# Copy this file to .env and fill in your values. Never commit .env.
# On a hosting platform, set these as environment variables in its dashboard instead.

# ---- Database --------------------------------------------------------------
# Local: postgresql+psycopg://payoff:<password>@localhost:5432/payoff
# Hosted (Neon etc.): paste the connection string it gives you (postgres:// works too)
DATABASE_URL=
# Used only by the test suite. It WIPES this database, so never point it at real data.
TEST_DATABASE_URL=

# ---- Server ----------------------------------------------------------------
# Which data feed to use: alpaca | tastytrade | schwab
DATA_SOURCE=alpaca
# Strikes per expiration, nearest the money (alpaca / tastytrade)
STRIKES=60
# 127.0.0.1 for local use; 0.0.0.0 when deployed
HOST=127.0.0.1
# Most hosts (Render, Railway, Heroku, Fly) set PORT automatically
PORT=8765
# Send the login cookie over HTTPS only. true when deployed.
COOKIE_SECURE=false
# Comma-separated public hostnames the server will answer to, e.g. my-app.onrender.com
# (localhost and 127.0.0.1 are always allowed)
ALLOWED_HOSTS=

# ---- Alpaca (free paper account works) ----------------------------------------
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Optional: opra / sip with the Algo Trader Plus subscription
ALPACA_OPTIONS_FEED=indicative
ALPACA_STOCK_FEED=iex

# ---- tastytrade (funded account) ----------------------------------------------
TASTY_CLIENT_SECRET=
TASTY_REFRESH_TOKEN=

# ---- Schwab (approved developer app; needs an interactive login, local only) --
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_TOKEN_FILE=schwab_tokens.json
